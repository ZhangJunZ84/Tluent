{
  "name": "tluentlibrary",
  "version": "0.0.2",
  "description": "",
  "main": "init.lua",
  "scripts": {
    "rojo": "mkdirp dist && rojo build -o dist/main.rbxm",
    "bundle": "npm run rojo && lune build",
    "build": "mkdirp dist && rojo build -o dist/main.rbxm && lune build",
    "live": "mkdirp dist && python -m http.server 8642",
    "watch": "chokidar \"src\" -c \"npm run build\"",
    "live-build": "npm run build && concurrently \"npm run live\" \"npm run watch\""
  },
  "keywords": [],
  "author": "TWVZ",
  "license": "MIT",
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "mkdirp": "^3.0.1"
  }
}
